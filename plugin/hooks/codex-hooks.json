{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/dispatch.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\dispatch.mjs\"",
            "timeout": 30,
            "statusMessage": "Dispatching protected GitHub operation checks"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/dispatch.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\dispatch.mjs\"",
            "timeout": 45,
            "statusMessage": "Dispatching post-merge status"
          }
        ]
      }
    ]
  }
}
